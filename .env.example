# Neon pooled PostgreSQL URL — server-only, never use NEXT_PUBLIC_ for this
DATABASE_URL=postgresql://user:password@your-host-pooler.neon.tech/neondb?sslmode=verify-full

# Use real database records (set true only for UI previews)
MOCK_MODE=false

# Admin panel password (protects /[year]/admin)
ADMIN_PASSWORD=your-admin-password

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1
